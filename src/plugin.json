      "name": "consolmonitoring"
    },
    "keywords": ["datasource", "thruk", "omd", "monitoring", "rest api"],
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "GitHub",
        "url": "https://github.com/ConSol-Monitoring/grafana-thruk-backend-datasource"
      },
      {
        "name": "Documentation",
        "url": "https://github.com/ConSol-Monitoring/grafana-thruk-backend-datasource/blob/master/README.md"
      },
      {
        "name": "License",
        "url": "https://github.com/ConSol-Monitoring/grafana-thruk-backend-datasource/blob/master/LICENSE"
      },
      {
        "name": "Raise issue",
        "url": "https://github.com/ConSol-Monitoring/grafana-thruk-backend-datasource/issues"
      },
      {
        "name": "Sponsorship",
        "url": "https://github.com/ConSol-Monitoring/"
      }
    ],
    "screenshots": [
      {
        "name": "Thruk Datasource with Backend",
